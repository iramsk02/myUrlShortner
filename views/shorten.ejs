<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shorten</title>
  <link rel="stylesheet" href="/style.css">
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</head>

<body>
  <nav class="nav">
    <div class="logo">InBits</div>
    <ul>
      <li class="li"><a href="/">Home</a></li>
      <li class="li"><a href="/about">About Us</a></li>
      <li class="li"><a href="/contact">Contact Us</a></li>
      <li class="li"><a href="/shorten">Shorten</a></li>
    </ul>
  </nav>

  <main>
    <h1>Shorten Your URL</h1>
    <div class="forms">
      <form id="shortenForm">
        <label for="originalUrl">Original URL:</label>
        <input type="text" id="originalUrl" required>

        <label for="shortUrl">Custom Short URL (optional):</label>
        <input type="text" id="shortUrl">

        <button type="submit" class="subtn">Generate Short URL</button>
      </form>

      <div id="shortenResult" ></div>
    </div>
  </main>

  <!-- <footer style="margin-top:230px;">
    <p>&copy; 2024 InBits. All rights reserved.</p>
  </footer> -->

<script>
  const API_BASE = "https://myurlshortner-pogo.onrender.com"; 

  // Handle URL shortening
  document.getElementById('shortenForm').addEventListener('submit', async function (event) {
    event.preventDefault();

    const originalUrl = document.getElementById('originalUrl').value.trim();
    const shortUrl = document.getElementById('shortUrl').value.trim();

    try {
      const response = await axios.post(
        `${API_BASE}/api/shorten`,
        { originalUrl, shortUrl },
        { headers: { 'Content-Type': 'application/json' } }
      );

      if (response.data) {
        // document.getElementById('shortenResult').innerHTML = `<p>Your shortened URL: 
        //   <a class="url" style="margin: 5px; color: black;" 
        //   href="${API_BASE}/${response.data.shortUrl}" target="_blank">
        //   inbits/${response.data.shortUrl}</a></p>`;

        const fullUrl = `${API_BASE}/${response.data.shortUrl}`;
document.getElementById('shortenResult').innerHTML = `<p>Your shortened URL: 
  <a class="url" style="margin: 5px; color: black;" 
  href="${fullUrl}" target="_blank">
  inbits/${response.data.shortUrl}</a>
  <button onclick="navigator.clipboard.writeText('${fullUrl}')">Copy</button>
</p>`;

      } else {
        document.getElementById('shortenResult').innerHTML = '<p>Something went wrong. Try again.</p>';
      }
    } catch (error) {
      console.error('Error shortening the URL:', error);
      const message = error.response?.data?.error || error.message || "Server error";
      document.getElementById('shortenResult').innerHTML = `<p style="color: black;">Error: ${message}</p>`;
    }
  });
</script>

</body>
</html>
