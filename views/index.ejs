<!DOCTYPE html>
<html lang="en">

<head>
    <title><%= title %></title>
    <link rel="stylesheet" type="text/css" href="/style.css">
</head>

<body>
    <nav class="nav">
        <div class="logo">InBits</div>
        <ul>
            <li class="li"><a href="/">Home</a></li>
            <li class="li"><a href="/about">About Us</a></li>
            <li class="li"><a href="/contact">Contact Us</a></li>
            <li class="li"><a href="/shorten">Shorten</a></li>
        </ul>
    </nav>

    <div class="maindiv">
        <h1>Welcome to My Website</h1>
        <main>
            <div class="d1">
                <div class="img">
                    <img src="https://img.freepik.com/free-vector/remote-working-scenes-elements_52683-56958.jpg" 
                        alt="Working remotely">
                </div>
                <div class="text">
                    <h3>Transform your long, cumbersome links into sleek, shareable short URLs with ease.</h3>
                    <p>Join the InBits community today and start sharing smarter!</p>
                </div>
            </div>

            <div class="d2">
                <a href="/shorten"><button class="btn">Try Now</button></a>
                <a href="/contact"><button class="btn">Contact</button></a>
            </div>
        </main>
    </div>

    <footer style="margin-top: 102px;">
        <p>&copy; 2024 InBits. All rights reserved.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
        document.getElementById("try").addEventListener("click", async () => {
            await axios.get('/api/shorten');
        });
    </script>
</body>

</html>
