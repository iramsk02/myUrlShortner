<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" type="text/css" href="/style.css">
</head>

<body>
    <nav class="nav">
        <div class="logo">InBits</div>
        <ul>
            <li class="li"><a href="/">Home</a></li>
            <li class="li"><a href="/about">About Us</a></li>
            <li class="li"><a href="/contact">Contact Us</a></li>
            <li class="li"><a href="/shorten">Shorten</a></li>
        </ul>
    </nav>

    <header>
        <h1>Contact Us</h1>
        <p>Need help or have a question? Reach out to us!</p>
    </header>

    <section class="contact-form">
        <h2>Send Us a Message</h2>
        <form action="/contact" method="POST">
            <input type="text" name="name" placeholder="Your Name" required>
            <input type="email" name="email" placeholder="Your Email" required>
            <textarea name="message" placeholder="Your Message" required></textarea>
            <button type="submit" class="send">Send Message</button>
        </form>
    </section>
<!-- 
    <footer style="margin-top: 65px;">
        <p>&copy; 2024 InBits. All rights reserved.</p>
    </footer> -->
</body>
</html>
